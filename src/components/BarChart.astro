---
/**
 * A simple horizontal bar chart drawn as inline SVG from a small data array.
 * Every bar is labelled with its value; a screen reader gets a data table.
 * Use it for tokens and cost per act. Values come from .research/measurements.md.
 *
 * Usage (MDX):
 *   <BarChart
 *     title="Input tokens per act, logs task"
 *     unit="tokens"
 *     data={[
 *       { label: 'b1', value: 100197 },
 *       { label: 'b2', value: 56887, note: 'refused' },
 *       { label: 'c', value: 31101, note: 'refused' },
 *     ]}
 *   />
 *
 * Props: data (label, value, optional display text, optional note),
 * title, unit (shown in the table header and the caption), optional source line,
 * optional max (fix the scale so two charts compare), optional decimals.
 */
interface Datum {
	label: string;
	value: number;
	/** Text shown at the end of the bar instead of the formatted value. */
	display?: string;
	/** A short note after the value, such as "refused" or "not measured". */
	note?: string;
}
interface Props {
	title: string;
	data: Datum[];
	unit?: string;
	source?: string;
	max?: number;
	decimals?: number;
}
const { title, data, unit = '', source, max, decimals } = Astro.props;
const fmt = (v: number) =>
	v.toLocaleString('en-US', decimals !== undefined ? { minimumFractionDigits: decimals, maximumFractionDigits: decimals } : {});
const top = max ?? Math.max(...data.map((d) => d.value), 0);
const W = 720;
const labelW = Math.min(260, Math.max(60, ...data.map((d) => d.label.length * 10 + 24)));
const valueW = 230;
const barArea = W - labelW - valueW;
const rowH = 40;
const barH = 22;
const H = data.length * rowH + 8;
const id = `bar-${Math.random().toString(36).slice(2, 9)}`;
const rows = data.map((d, i) => {
	const w = top > 0 ? Math.max(2, (d.value / top) * barArea) : 2;
	const y = 4 + i * rowH;
	const text = (d.display ?? `${fmt(d.value)}${unit ? ' ' + unit : ''}`) + (d.note ? `  (${d.note})` : '');
	return { ...d, w, y, text };
});
---

<figure class="aib-bars aib-diagram">
	<figcaption id={`${id}-t`}>
		<span class="aib-label">{title}</span>
	</figcaption>
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-t`} aria-describedby={`${id}-d`} preserveAspectRatio="xMinYMin meet">
		{
			rows.map((r) => (
				<g>
					<text x={labelW - 12} y={r.y + barH / 2 + 6} text-anchor="end" class="aib-bars-label">
						{r.label}
					</text>
					<rect x={labelW} y={r.y} width={r.w} height={barH} rx="2" class="aib-bars-bar" />
					<text x={labelW + r.w + 8} y={r.y + barH / 2 + 6} class="aib-bars-value">
						{r.text}
					</text>
				</g>
			))
		}
		<line x1={labelW} x2={labelW} y1="0" y2={H} class="aib-bars-axis" />
	</svg>
	<table id={`${id}-d`} class="aib-visually-hidden">
		<caption>{title}</caption>
		<thead>
			<tr><th scope="col">Item</th><th scope="col">{unit || 'Value'}</th><th scope="col">Note</th></tr>
		</thead>
		<tbody>
			{rows.map((r) => (
				<tr><th scope="row">{r.label}</th><td>{r.display ?? fmt(r.value)}</td><td>{r.note ?? ''}</td></tr>
			))}
		</tbody>
	</table>
	{source && <p class="aib-bars-source">Source: {source}</p>}
</figure>

<style>
	.aib-bars {
		margin: 1.5rem 0 0;
	}
	.aib-bars svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.aib-bars-bar {
		fill: var(--sl-color-accent);
	}
	.aib-bars-label {
		fill: var(--sl-color-white);
		font-size: 17px;
		font-weight: 600;
	}
	.aib-bars-value {
		fill: var(--sl-color-gray-2);
		font-size: 16px;
		font-variant-numeric: tabular-nums;
	}
	.aib-bars-axis {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.aib-bars-source {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin-top: 0.25rem;
	}
</style>
