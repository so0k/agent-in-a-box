---
/**
 * A simple horizontal bar chart from a small data array, built as an HTML grid
 * so its text is page text at page sizes. All rows share one bar track, so bars
 * compare; `max` fixes the scale so two charts compare too. Every bar is
 * labelled with its value; a screen reader gets a data table instead.
 * Use it for tokens and cost per act. Values come from .research/measurements.md.
 *
 * Usage (MDX):
 *   <BarChart
 *     title="Input tokens per act, logs task"
 *     unit="tokens"
 *     data={[
 *       { label: 'opaque-execute', value: 100197 },
 *       { label: 'deny-execute', value: 56887, note: 'refused' },
 *       { label: 'request-rules', value: 31101, note: 'refused' },
 *     ]}
 *   />
 *
 * Props: data (label, value, optional display text, optional note),
 * title, unit (shown in the table header and after each value), optional source line,
 * optional max (fix the scale so two charts compare), optional decimals.
 */
interface Datum {
	label: string;
	value: number;
	/** Text shown next to the bar instead of the formatted value. */
	display?: string;
	/** A short note after the value, such as "refused" or "not measured". */
	note?: string;
}
interface Props {
	title: string;
	data: Datum[];
	unit?: string;
	source?: string;
	max?: number;
	decimals?: number;
}
const { title, data, unit = '', source, max, decimals } = Astro.props;
const fmt = (v: number) =>
	v.toLocaleString('en-US', decimals !== undefined ? { minimumFractionDigits: decimals, maximumFractionDigits: decimals } : {});
const top = max ?? Math.max(...data.map((d) => d.value), 0);
const id = `bar-${Math.random().toString(36).slice(2, 9)}`;
const rows = data.map((d) => {
	const share = top > 0 ? Math.min(1, Math.max(0, d.value / top)) : 0;
	const text = d.display ?? `${fmt(d.value)}${unit ? ' ' + unit : ''}`;
	return { ...d, share, text };
});
---

<figure class="aib-bars aib-diagram" aria-labelledby={`${id}-t`}>
	<figcaption id={`${id}-t`}>
		<span class="aib-label">{title}</span>
	</figcaption>
	<div class="aib-bars-grid" aria-hidden="true">
		{
			rows.map((r) => (
				<div class="aib-bars-row">
					<span class="aib-bars-label">{r.label}</span>
					<span class="aib-bars-plot">
						<span class="aib-bars-bar" style={`--aib-share: ${r.share}`} />
						<span class="aib-bars-value">
							<span class="aib-bars-num">{r.text}</span>
							{r.note && <span class="aib-bars-note"> ({r.note})</span>}
						</span>
					</span>
				</div>
			))
		}
	</div>
	<table class="aib-visually-hidden">
		<caption>{title}</caption>
		<thead>
			<tr><th scope="col">Item</th><th scope="col">{unit || 'Value'}</th><th scope="col">Note</th></tr>
		</thead>
		<tbody>
			{rows.map((r) => (
				<tr><th scope="row">{r.label}</th><td>{r.display ?? fmt(r.value)}</td><td>{r.note ?? ''}</td></tr>
			))}
		</tbody>
	</table>
	{source && <p class="aib-bars-source">Source: {source}</p>}
</figure>

<style>
	.aib-bars {
		margin: 1.5rem 0 0;
		container-type: inline-size;
	}
	/* One grid for all rows: label, then the plot (bar with its value at the bar's end). */
	.aib-bars-grid {
		display: grid;
		grid-template-columns: fit-content(min(18rem, 36%)) minmax(0, 1fr);
		column-gap: 0.75rem;
		margin-top: 0.25rem;
		/* Room kept free after the longest bar for its value; all bars share the rest as their scale. */
		--aib-value-room: min(17rem, 45%);
	}
	.aib-bars-row {
		display: contents;
	}
	.aib-bars-row > * {
		padding-block: 0.4rem;
		min-width: 0;
	}
	.aib-bars-label {
		font-size: var(--sl-text-body);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
		text-align: end;
		overflow-wrap: anywhere;
	}
	/* The plot's start edge is the axis; padding instead of a row gap keeps it unbroken. */
	.aib-bars-plot {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		border-inline-start: 1px solid var(--sl-color-gray-4);
	}
	.aib-bars-bar {
		flex: 0 0 auto;
		height: 1rem;
		width: max(3px, calc(var(--aib-share) * (100% - var(--aib-value-room))));
		background: var(--sl-color-accent);
		border-radius: 0 3px 3px 0;
	}
	.aib-bars-value {
		flex: 1 1 0;
		min-width: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.35;
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.aib-bars-num {
		white-space: nowrap;
	}
	.aib-bars-note {
		color: var(--sl-color-gray-3);
	}
	/* Narrow: the label on its own line, then the bar at full scale, then the value. */
	@container (max-width: 32rem) {
		.aib-bars-grid {
			grid-template-columns: minmax(0, 1fr);
			--aib-value-room: 0%;
		}
		.aib-bars-label {
			text-align: start;
			padding-block: 0.5rem 0.1rem;
		}
		.aib-bars-plot {
			flex-wrap: wrap;
			row-gap: 0.2rem;
			padding-block: 0.1rem 0.4rem;
		}
		.aib-bars-value {
			flex-basis: 100%;
			padding-inline-start: 0.4rem;
		}
	}
	.aib-bars-source {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin-top: 0.25rem;
	}
</style>
