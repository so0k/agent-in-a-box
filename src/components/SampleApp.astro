---
/**
 * The running example: the workshop progress tracker and leaderboard on
 * Cloudflare. Same visual language as <Pieces>. The places that hold attendee
 * names and email addresses carry the ring marker and a faint tint, both in
 * the personal-data colour.
 * Source: .research/sample-app.md (sections 2 to 4).
 *
 * Usage (MDX):
 *   <SampleApp />
 */
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
const uid = `sa-${Math.random().toString(36).slice(2, 8)}`;

type Node = { x: number; y: number; w: number; h: number; title: string[]; sub?: string[]; personal?: boolean; stack?: boolean; outside?: boolean; desc: string };
const NODES: Node[] = [
	{ x: 20, y: 70, w: 190, h: 64, title: ["Attendee's browser"], sub: ['the workshop website'], desc: "the attendee's browser: components on the workshop website call the Worker's JSON API with a bearer token" },
	{ x: 20, y: 270, w: 190, h: 64, title: ["Facilitator's browser"], sub: ['the dashboard'], desc: "the facilitator's browser: the dashboard, live over a WebSocket, behind a secret" },
	{ x: 275, y: 160, w: 190, h: 90, title: ['Worker'], sub: ['box-poc-workshop:', 'routes, checks, logs'], desc: "the Worker box-poc-workshop: routes the API, reads each page's check from KV, and writes one log object per event" },
	{ x: 540, y: 40, w: 235, h: 58, title: ['AttendeeSession'], sub: ['Durable Object, one per session'], personal: true, stack: true, desc: "AttendeeSession, a Durable Object, one per attendee session: the attendee's endpoints, a verdict per page, rate-limit buckets and the optional name and email" },
	{ x: 540, y: 113, w: 235, h: 58, title: ['WorkshopBoard'], sub: ['Durable Object, one per workshop'], personal: true, desc: "WorkshopBoard, a Durable Object, one per workshop: hands out session seats one at a time, keeps each session's progress and pushes snapshots to the dashboard" },
	{ x: 540, y: 186, w: 235, h: 58, title: ['D1 database'], sub: ['the session registry'], personal: true, desc: 'the D1 database box-poc-workshop: the session registry, with the optional display name and email' },
	{ x: 540, y: 259, w: 235, h: 58, title: ['KV namespace'], sub: ['the 40 workshop pages, public'], desc: 'the KV namespace box-poc-workshop-content: the 40 workshop pages and their checks; public content' },
	{ x: 540, y: 332, w: 235, h: 58, title: ['Workers Logs'], sub: ['one log object per event'], personal: true, desc: 'Workers Logs: one log object per event; events for a session on the board include its email, and some include names' },
	{ x: 830, y: 34, w: 150, h: 70, title: ["Attendee's", 'own endpoint'], sub: ['outside Cloudflare'], outside: true, desc: "the attendee's own endpoint, outside Cloudflare, which the session object checks with one GET per check" },
];
const EDGES: { d: string; label?: { x: number; y: number; text: string; anchor?: string } }[] = [
	{ d: 'M210,102 H300 V160', label: { x: 218, y: 92, text: 'progress, bearer token' } },
	{ d: 'M210,302 H300 V250', label: { x: 218, y: 322, text: 'dashboard, WebSocket' } },
	{ d: 'M465,205 H505 V69 H540' },
	{ d: 'M465,205 H505 V142 H540' },
	{ d: 'M465,205 H505 V215 H540' },
	{ d: 'M465,205 H505 V288 H540' },
	{ d: 'M465,205 H505 V361 H540' },
	{ d: 'M775,69 H830' },
];
---

<figure class="aib-sampleapp aib-diagram">
	<svg viewBox="0 0 1000 430" role="img" aria-labelledby={`${uid}-t ${uid}-d`} preserveAspectRatio="xMidYMid meet">
		<title id={`${uid}-t`}>The sample app: workshop progress tracker and leaderboard on Cloudflare</title>
		<desc id={`${uid}-d`}>
			Two browsers call the Worker box-poc-workshop. The Worker uses two Durable Objects (AttendeeSession, one per session, and
			WorkshopBoard, one per workshop), a D1 database, a KV namespace and Workers Logs. AttendeeSession, WorkshopBoard, D1 and
			Workers Logs hold attendee names and email addresses. A full text description follows the diagram.
		</desc>
		<defs>
			<marker id={`${uid}-arr`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
				<path d="M0,0 L10,5 L0,10 z" class="aib-sa-arrow" />
			</marker>
		</defs>
		<g class="aib-sa-zone">
			<rect x="245" y="20" width="555" height="390" rx="6" />
			<text x="258" y="40">Cloudflare account</text>
		</g>
		<g>
			{
				EDGES.map((e) => (
					<g class="aib-sa-edge">
						<path d={e.d} marker-end={`url(#${uid}-arr)`} />
						{e.label && (
							<text x={e.label.x} y={e.label.y} text-anchor={e.label.anchor ?? 'start'}>
								{e.label.text}
							</text>
						)}
					</g>
				))
			}
		</g>
		<g>
			{
				NODES.map((n) => {
					const sub = n.sub ?? [];
					const lines = n.title.length + sub.length;
					const lineH = 17;
					const firstY = n.y + n.h / 2 - ((lines - 1) * lineH) / 2 + 5;
					return (
						<g class:list={['aib-sa-node', { 'is-outside': n.outside, 'is-personal': n.personal }]}>
							{n.stack && <rect x={n.x + 6} y={n.y - 6} width={n.w} height={n.h} rx="4" class="aib-sa-stack" />}
							<rect x={n.x} y={n.y} width={n.w} height={n.h} rx="4" />
							{n.title.map((t, i) => (
								<text x={n.x + n.w / 2} y={firstY + i * lineH} text-anchor="middle" class="aib-sa-title">
									{t}
								</text>
							))}
							{sub.map((t, i) => (
								<text x={n.x + n.w / 2} y={firstY + (n.title.length + i) * lineH} text-anchor="middle" class="aib-sa-sub">
									{t}
								</text>
							))}
							{n.personal && <circle cx={n.x + 14} cy={n.y + 14} r="5" class="aib-sa-personal" />}
						</g>
					);
				})
			}
		</g>
		<text x="905" y="124" text-anchor="middle" class="aib-sa-note">one GET per check</text>
		<g class="aib-sa-legend" transform="translate(20 380)">
			<rect x="0" y="-9" width="24" height="18" rx="3" class="aib-sa-swatch" />
			<circle cx="9" cy="0" r="5" class="aib-sa-personal" />
			<text x="32" y="5">holds names and</text>
			<text x="32" y="22">email addresses</text>
		</g>
	</svg>
	<figcaption>
		{caption && <p class="aib-sampleapp-caption">{caption}</p>}
		<details class="aib-sampleapp-text">
			<summary>Text description of the diagram</summary>
			<ul>
				{
					NODES.map((n) => (
						<li>
							{n.desc}
							{n.personal && ' (holds names and email addresses)'}
						</li>
					))
				}
			</ul>
		</details>
	</figcaption>
</figure>

<style>
	.aib-sampleapp {
		margin: 1.5rem 0 0;
	}
	.aib-sampleapp svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.aib-sa-zone rect {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.aib-sa-zone text {
		fill: var(--sl-color-gray-2);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.aib-sa-node rect {
		fill: var(--aib-node-bg);
		stroke: var(--aib-node-line);
		stroke-width: 1.5;
	}
	.aib-sa-node.is-personal rect,
	.aib-sa-swatch {
		fill: color-mix(in srgb, var(--aib-personal) 10%, var(--aib-node-bg));
	}
	.aib-sa-node.is-outside rect {
		stroke-dasharray: 5 4;
	}
	.aib-sa-title {
		fill: var(--sl-color-white);
		font-size: 15px;
		font-weight: 700;
	}
	.aib-sa-sub {
		fill: var(--sl-color-gray-2);
		font-size: 12.5px;
	}
	.aib-sa-personal {
		fill: none;
		stroke: var(--aib-personal);
		stroke-width: 2.5;
	}
	.aib-sa-edge path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.aib-sa-arrow {
		fill: var(--sl-color-gray-3);
	}
	.aib-sa-edge text,
	.aib-sa-note,
	.aib-sa-legend text {
		fill: var(--sl-color-gray-2);
		font-size: 12.5px;
		paint-order: stroke;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.aib-sampleapp figcaption {
		margin-top: 0.5rem;
	}
	.aib-sampleapp-caption {
		margin: 0.25rem 0 0;
	}
	.aib-sampleapp-text {
		font-size: var(--sl-text-sm);
	}
	.aib-sampleapp-text summary {
		cursor: pointer;
		color: var(--sl-color-gray-2);
	}
</style>
