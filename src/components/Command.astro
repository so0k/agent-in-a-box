---
/**
 * One command the reader types, with a short "what this does" line above it
 * and, under the code block, an optional list of <Flag> explanations.
 *
 * Usage (MDX):
 *   <Command what="Shows the profile as Box resolves it.">
 *   ```sh
 *   box profile show workshop
 *   ```
 *   <Flag name="--full">Also prints the generated box.toml and policy.dw.</Flag>
 *   </Command>
 */
interface Props {
	/** One sentence: what the command does. */
	what: string;
}
const { what } = Astro.props;
---

<div class="aib-command">
	<p class="aib-command-what"><span class="aib-label">What this does</span>{what}</p>
	<slot />
</div>

<style>
	.aib-command {
		margin-top: 1.5rem;
		border-left: 3px solid var(--sl-color-accent);
		padding-left: 1rem;
	}
	.aib-command-what {
		margin: 0 0 0.5rem;
	}
	.aib-command-what .aib-label {
		display: inline;
		margin-right: 0.5rem;
	}
	.aib-command :global(.aib-flag:not(.aib-flag + .aib-flag)) {
		margin-top: 0.75rem;
		border-top: 1px solid var(--aib-line);
		padding-top: 0.75rem;
	}
	.aib-command :global(.aib-flag:not(.aib-flag + .aib-flag))::before {
		content: 'Flags';
		display: block;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		margin-bottom: 0.35rem;
		grid-column: 1 / -1;
	}
</style>
