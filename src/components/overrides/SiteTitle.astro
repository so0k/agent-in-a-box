---
// Starlight's site title, with a button in front that hides or shows the side menu on wide screens.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<button
	class="aib-sidebar-toggle print:hidden"
	type="button"
	aria-controls="starlight__sidebar"
	aria-expanded="true"
	aria-label="Hide the side menu"
	title="Hide the side menu"
>
	<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="16" rx="2"></rect>
		<path d="M9 4v16"></path>
	</svg>
</button>
<Default><slot /></Default>

<script is:inline>
	// Runs while the header is parsed, before the side menu paints, so a hidden menu never flashes.
	(() => {
		const KEY = 'aib-sidebar';
		const root = document.documentElement;
		const button = document.querySelector('.aib-sidebar-toggle');
		const apply = (collapsed) => {
			if (collapsed) root.dataset.aibSidebar = 'collapsed';
			else delete root.dataset.aibSidebar;
			const label = collapsed ? 'Show the side menu' : 'Hide the side menu';
			button.setAttribute('aria-expanded', String(!collapsed));
			button.setAttribute('aria-label', label);
			button.title = label;
		};
		let stored = null;
		try {
			stored = localStorage.getItem(KEY);
		} catch {}
		apply(stored === 'collapsed');
		button.addEventListener('click', () => {
			const collapsed = root.dataset.aibSidebar !== 'collapsed';
			apply(collapsed);
			try {
				localStorage.setItem(KEY, collapsed ? 'collapsed' : 'open');
			} catch {}
		});
	})();
</script>

<style>
	.aib-sidebar-toggle {
		display: none;
	}
	@media (min-width: 50rem) {
		:global([data-has-sidebar]) .aib-sidebar-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			align-self: center;
			width: 2rem;
			height: 2rem;
			/* The icon, not the button's padding, lines up with the page text below. */
			margin-inline: -0.4375rem 0.5rem;
			border: 0;
			border-radius: 0.25rem;
			background: transparent;
			color: var(--sl-color-gray-3);
			cursor: pointer;
		}
		.aib-sidebar-toggle:hover {
			color: var(--sl-color-text-accent);
			background: var(--sl-color-gray-6);
		}
	}
</style>
